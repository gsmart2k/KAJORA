{
  "expo": {
    "name": "KAJORA",
    "slug": "kajora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/launch-symbol-only.png",
    "scheme": "kajora",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/brand/launch-symbol-only.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F5132",
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "monochromeImage": "./assets/brand/adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/brand/splash-symbol-only.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos to share with your KAJORA group.",
          "cameraPermission": "Take a photo to share with your KAJORA group.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
