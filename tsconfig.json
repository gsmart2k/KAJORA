{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "src/app/**/*.ts",
    "src/app/**/*.tsx",
    "src/components/app-shell.tsx",
    "src/components/intent-card.tsx",
    "src/components/ui.tsx",
    "src/data/**/*.ts",
    "src/state/**/*.tsx",
    "src/theme/**/*.ts",
    "src/types/**/*.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
